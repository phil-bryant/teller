#!/bin/bash
set -e
source ~/.env
export PGPASSWORD=$TELLER_POSTGRES_PASSWORD

## First we must use the admin user to create the teller database, teller schema, and tellerroles
psql -U postgres -f create_database.sql
psql -U postgres -d teller -v TELLER_POSTGRES_PASSWORD="$TELLER_POSTGRES_PASSWORD" -f configure_database.sql

## Then we can use the teller user to create the teller tables in dependency order
psql -U teller -d teller -f teller_enums.sql
psql -U teller -d teller -f teller_institution.sql
psql -U teller -d teller -f teller_account_links.sql
psql -U teller -d teller -f teller_account.sql
psql -U teller -d teller -f teller_identity.sql
psql -U teller -d teller -f teller_identity_name.sql
psql -U teller -d teller -f teller_identity_email.sql
psql -U teller -d teller -f teller_identity_phone_number.sql
psql -U teller -d teller -f teller_identity_address_data.sql
psql -U teller -d teller -f teller_identity_address.sql
psql -U teller -d teller -f teller_account_identities.sql
psql -U teller -d teller -f teller_routing_numbers.sql
psql -U teller -d teller -f teller_account_details_links.sql
psql -U teller -d teller -f teller_account_details.sql
psql -U teller -d teller -f teller_account_balances_links.sql
psql -U teller -d teller -f teller_account_balances.sql
psql -U teller -d teller -f teller_transaction_type.sql
psql -U teller -d teller -f teller_transaction_details_counterparty.sql
psql -U teller -d teller -f teller_transaction_links.sql
psql -U teller -d teller -f teller_transaction_details.sql
psql -U teller -d teller -f teller_transaction.sql
psql -U teller -d teller -f create_triggers.sql
psql -U teller -d teller -f create_audit.sql

unset PGPASSWORD