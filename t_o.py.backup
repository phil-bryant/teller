#! /usr/bin/env python3
from t_c_type import APIClient
from multipledispatch import dispatch
from t_d_type import APIDataT

class MyObject():
    _path: str = ""
    _api_client: APIClient = None

    @dispatch(APIClient)
    def __init__(self, api_client: APIClient):
        self._api_data: list = []
        self._api_client = api_client

    @dispatch(dict)
    def __init__(self, api_data: dict):
        self._api_data: dict = api_data

    @dispatch(list)
    def __init__(self, api_data: list):
        self._api_data: list = api_data

    @dispatch(APIClient, dict)
    def __init__(self, api_client: APIClient, api_data: dict):
        self._api_client: APIClient = api_client
        self._api_data: dict = api_data

    @dispatch(APIClient, list)
    def __init__(self, api_client: APIClient, api_data: list):
        self._api_client: APIClient = api_client
        self._api_data: list = api_data
 

    def __str__(self):
        return f"{super().__str__()}: _path = {self._path}; _api_client = {self._api_client}; _api_data = {self._api_data}"
